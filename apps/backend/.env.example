DATABASE_URL="postgresql://postgres:postgres@localhost:5432/omnichannel_ai?schema=public"
MISTRAL_API_KEY="replace_with_mistral_key"
MISTRAL_MODEL="mistral-small-latest"
BACKEND_PORT=4000
FRONTEND_ORIGIN="http://localhost:3000"
TELEGRAM_BOT_TOKEN="replace_with_telegram_bot_token"
TELEGRAM_BOT_USERNAME="your_bot_username_without_at"
TELEGRAM_WEBHOOK_SECRET_TOKEN="replace_with_telegram_webhook_secret_token"
SLACK_BOT_TOKEN="xoxb-your-slack-bot-token"
SLACK_SIGNING_SECRET="replace_with_slack_signing_secret"
SLACK_CLIENT_ID="your_slack_client_id"
SLACK_CLIENT_SECRET="your_slack_client_secret"
SLACK_REDIRECT_URI="http://localhost:4000/api/users/connect/slack/callback"
APP_BASE_URL="http://localhost:3000"
WHATSAPP_ACCESS_TOKEN="replace_with_whatsapp_access_token"
WHATSAPP_VERIFY_TOKEN="replace_with_whatsapp_verify_token"
WHATSAPP_PHONE_NUMBER_ID="replace_with_whatsapp_phone_number_id"
WEBHOOK_IDEMPOTENCY_TTL_MS=300000
ADMIN_API_TOKEN="dev-admin-token"
ADMIN_RATE_LIMIT_PER_MINUTE=120
JWT_SECRET="dev-jwt-secret"
JWT_EXPIRES_IN="7d"
